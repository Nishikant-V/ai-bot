# ── Backend (set these in Render dashboard) ───────────────────────────────────

# Neon PostgreSQL connection string
# Get from: https://neon.tech → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require

# Groq API key for AI summaries
# Get from: https://console.groq.com → API Keys
# If unset, app falls back to extractive (keyword-based) summaries
GROQ_API_KEY=gsk_...

# Optional: override default model (llama3-8b-8192 is free and fast)
GROQ_MODEL=llama3-8b-8192

# Protects POST /ingest from unauthenticated calls
# Choose any random string — keep it secret, never expose in frontend code
# If unset, /ingest is open (acceptable for local dev only)
INGEST_API_KEY=your-secret-key-here

# ── Frontend (set these in Vercel dashboard) ──────────────────────────────────

# Full URL of your Render backend (no trailing slash)
# Example: https://news-ai-backend.onrender.com
# Required for production — in dev this is unused (Vite proxy handles /api)
VITE_API_BASE=https://your-render-service.onrender.com
