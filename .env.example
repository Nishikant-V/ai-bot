# ── Backend (set these in Render dashboard) ───────────────────────────────────

# Neon PostgreSQL connection string — REQUIRED
# Get from: https://neon.tech → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:pass@ep-xxx-yyy.region.aws.neon.tech/dbname?sslmode=require

# Protects POST /ingest from unauthenticated calls — REQUIRED in production
# Choose any random string. Never expose in frontend code.
INGEST_API_KEY=your-secret-key-here

# ── LLM Providers (ALL OPTIONAL — app works without any) ─────────────────────
# Priority order: OpenRouter → Gemini → extractive fallback (keyword-based)

# Option 1: OpenRouter (recommended — free models, no credit card)
# Get from: https://openrouter.ai → API Keys
# Free model used by default: meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free   # optional override

# Option 2: Gemini 1.5 Flash (free tier via Google AI Studio)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-1.5-flash   # optional override

# ── Frontend (set these in Vercel dashboard) ──────────────────────────────────

# Full URL of your Render backend — no trailing slash
# Example: https://news-ai-backend.onrender.com
# Set AFTER deploying backend to Render. In dev, Vite proxy handles /api.
VITE_API_BASE=https://your-render-service.onrender.com
